# Where the backend API runs (Express + Socket.IO)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Photo uploads. With both set, photos go to Cloudinary through an unsigned upload preset.
# Without them the app runs in demo mode and stores a tiny thumbnail instead (fine for local testing only).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
